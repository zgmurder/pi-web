# Documentation only: `create` generates the actual root-only /etc/pi-web/alice.env.
# Never source this file as a shell script or commit real credentials.
HOME=/home/pi-alice
SHELL=/bin/bash
PI_CODING_AGENT_DIR=/home/pi-alice/.pi/agent
PI_WEB_PORT=30151
PI_WEB_ALLOWED_HOSTS=alice.pi.internal
PI_WEB_MARKET_DIR=/opt/pi-market
# The administrator generates a unique 64-character hex password for each instance.
PI_WEB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PI_TELEMETRY=0
PI_OFFLINE=1
PI_SKIP_VERSION_CHECK=1
PI_WEB_SKIP_VERSION_CHECK=1
